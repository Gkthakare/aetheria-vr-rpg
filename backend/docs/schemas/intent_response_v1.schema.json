{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aetheria.local/schemas/intent_response_v1.schema.json",
  "title": "AetheriaIntentResponseV1",
  "description": "Backend response after parsing player voice/text. Unity uses this to spawn catalog entities, tweak world params, or run narrative hooks.",
  "type": "object",
  "required": ["version", "intentType", "confidence"],
  "properties": {
    "version": {
      "type": "string",
      "const": "1"
    },
    "intentType": {
      "type": "string",
      "enum": [
        "spawn_enemy",
        "world_biome",
        "dungeon_grow",
        "npc_dialogue",
        "noop",
        "error"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "spawn": {
      "type": "object",
      "description": "Present when intentType is spawn_enemy.",
      "properties": {
        "catalogId": {
          "type": "string",
          "description": "Stable id matching a Unity ScriptableObject / Addressables key, e.g. creature.wolf.v1"
        },
        "displayName": { "type": "string" },
        "variants": {
          "type": "object",
          "description": "Runtime-safe tweaks (scale, tint, material preset ids).",
          "additionalProperties": true
        },
        "combat": {
          "type": "object",
          "properties": {
            "difficultyTier": {
              "type": "string",
              "enum": ["trash", "normal", "elite", "boss"]
            },
            "weaknessTags": {
              "type": "array",
              "items": { "type": "string" }
            },
            "resistanceTags": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        },
        "placement": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": ["near_player", "fixed_world", "dungeon_room"]
            },
            "minDistanceM": { "type": "number" },
            "maxDistanceM": { "type": "number" },
            "requireNavMesh": { "type": "boolean" },
            "worldPosition": {
              "type": "object",
              "properties": {
                "x": { "type": "number" },
                "y": { "type": "number" },
                "z": { "type": "number" }
              }
            }
          },
          "additionalProperties": true
        }
      },
      "required": ["catalogId"],
      "additionalProperties": true
    },
    "world": {
      "type": "object",
      "description": "Optional chunk/biome hints; can mirror existing ChunkParameters if you keep that path.",
      "additionalProperties": true
    },
    "narrative": {
      "type": "object",
      "description": "Optional quest or line id for later phases.",
      "additionalProperties": true
    },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
